# XBuddy Essens-Buddy — systemd-Service-Vorlage (SVC-1..4, ESSEN-23).
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Port 5052 (belegt in conventions/ports.md, PORT-2, `xbuddy-essen`).

[Unit]
Description=XBuddy Essens-Buddy-App
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
# Bot-Token-Sharing fuer Mini-App-PATCH-Auth via Init-Data (RAT-16, #684) —
# Eigentuemer ist eltern-chat; essen-Buddy liest read-only.
EnvironmentFile=__XBUDDY_DATA__/eltern-chat/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
Environment=ESSEN_FOTO_OVERRIDES_FILE=__XBUDDY_DATA__/essen/foto_overrides.json
ExecStart=__XBUDDY_PYTHON__ -m essen.main --host 127.0.0.1 --port 5052
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
