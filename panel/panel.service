# XBuddy Panel-Registry HTTP-Service (PREG-13/PREG-14/PREG-15) — systemd-Service-Vorlage.
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Bindet auf Loopback-Port 5041 (PORT-2). Öffentlich erreichbar nur über
# nginx-Origin auf :8443 (URL-12/URL-14).

[Unit]
Description=XBuddy Panel-Registry HTTP-Service (PREG-13/PREG-14/PREG-15)
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
# SVC-5 (#1891): der Panel-Store liegt AUSSERHALB des Checkouts. Bis 2026-08-18
# stand hier __XBUDDY_REPO__ — dieselbe Verletzung wie bei familie, aber mit
# schaerferer Folge: die Checkout-Datei panel/panels.json EXISTIERT (lokal,
# gitignoriert, Stand Juni). Fiele das Drop-In 10-data-path.conf weg, startete
# der Dienst nicht mit einem Fehler, sondern STILL gegen Monate alte Daten.
ExecStart=__XBUDDY_PYTHON__ -m panel.main --host 127.0.0.1 --port 5041 --panels __XBUDDY_DATA__/panel/panels.json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
