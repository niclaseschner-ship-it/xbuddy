# XBuddy Wetter-Buddy — systemd-Service-Vorlage (SVC-1..4, WETTER-22).
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Port 5030 aus dem PORT-2-Reserveblock für neue Buddys; die feste Eintragung
# in conventions/ports.md ist Folge-Ticket (OPEN-WETTER-D).

[Unit]
Description=XBuddy Wetter-Buddy-App
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
ExecStart=__XBUDDY_PYTHON__ -m wetter.main --host 127.0.0.1 --port 5030
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
