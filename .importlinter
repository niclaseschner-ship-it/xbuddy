# Architektur-Linter (import-linter) — Gate fuer Modul-Grenzen.
# Bauregeln: conventions/module-boundaries.md (MOD-*), CLAUDE.md §6.
# Lauf: `make lint` (ruft lint-imports). CI: .github/workflows/lint-imports.yml.
#
# Erfasst werden NUR Python-Importe. Service<->Service laeuft ueber HTTP
# (urllib) — das ist KEIN Python-Import und damit hier nicht pruefbar;
# diese Kante deckt DCOMP-1 (conventions/data-components.md) als Konvention.
#
# eltern-chat hat einen Bindestrich und ist kein importierbares Paket.
# grimp scannt es trotzdem vom Dateisystem (Module heissen `eltern-chat.*`),
# darum laesst es sich als source_modules/forbidden_modules adressieren —
# OHNE Rename. Empirisch verifiziert mit import-linter 2.11 / grimp 3.14.

[importlinter]
root_packages =
    eltern-chat
    essen
    familie
    hoerspiel
    kibuddy
    panel
    photo
    plan
    routine
    seiten
    tools
    wetter
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = MOD-1 Layer-Modell (eltern-chat -> Services -> tools)
type = layers
layers =
    eltern-chat
    essen | familie | hoerspiel | kibuddy | photo | plan | routine | seiten | wetter
    tools
containers =

[importlinter:contract:siblings]
name = MOD-2 Services sind voneinander unabhaengig
type = independence
modules =
    essen
    familie
    hoerspiel
    kibuddy
    photo
    plan
    routine
    seiten
    wetter

[importlinter:contract:tools-bottom]
name = MOD-3 tools importiert keine Komponente darueber
type = forbidden
source_modules =
    tools
forbidden_modules =
    eltern-chat
    essen
    familie
    hoerspiel
    kibuddy
    photo
    plan
    routine
    seiten
    wetter

[importlinter:contract:eltern-chat-top]
name = MOD-4 eltern-chat wird von keiner Komponente importiert
type = forbidden
source_modules =
    essen
    familie
    hoerspiel
    kibuddy
    photo
    plan
    routine
    seiten
    tools
    wetter
forbidden_modules =
    eltern-chat

[importlinter:contract:zugangsdaten-api]
name = MOD-5 zugangsdaten nur ueber Public-API
type = forbidden
source_modules =
    eltern-chat
    essen
    familie
    hoerspiel
    kibuddy
    photo
    plan
    routine
    seiten
    wetter
forbidden_modules =
    tools.zugangsdaten.store
    tools.zugangsdaten.config
allow_indirect_imports = True
