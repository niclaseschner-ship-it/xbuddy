# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets / environment
.env
.env.*
!.env.example

# Logs
*.log

# Controller-Instanz-Configs (FIG-23) — pro Instanz separat verwaltet,
# nicht im Repo. Format ist in config.example.json dokumentiert.
controller/**/config.json

# Router-Instanz-Konfig + Routing-Tabelle (ROU-18/19) — analog
# pro Deployment, nicht im Repo. Format: router/*.example.json
router/routing.json
router/config.json

# Eltern-Chat: Instanz-Konfig + Gesprächs-Datenbank (EC-15/EC-16) —
# pro Instanz separat, nicht im Repo. Format: eltern-chat/config.example.json
eltern-chat/config.json
eltern-chat/*.db

# Eltern-Chat: Onboarding-Speicher (ONB-5) — enthält den per Chat gesetzten
# Anbieter-Key, niemals ins Repo.
eltern-chat/onboarding-store.json

# Familien-Registry: Per-Instanz-Datei + Profilfotos (FAM-6) — je Instanz
# separat gepflegt, nicht im Repo. Format: familie/familie.example.json
familie/familie.json
familie/fotos/

# Zugangsdaten-Speicher (ZD-3) — Per-Instanz-Geheimnis-Datei. Hält
# Klartext-Geheimnisse, darf nie ins Repo (CLAUDE.md §8). Format:
# zugangsdaten/zugangsdaten.example.json
zugangsdaten/zugangsdaten.json

# Plan-Buddy: Per-Instanz-Konfig + Verantwortlichkeiten-DB (PLAN-9/PLAN-28) —
# je Instanz separat, nicht im Repo. Format: plan/plan.example.json
plan/plan.json
plan/plan.db
plan/plan.db-journal

# Test-Caches
.pytest_cache/
__pycache__/
