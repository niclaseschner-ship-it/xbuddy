# XBuddy Hörspiel-Buddy — systemd-Service-Vorlage Neko-Instanz (RAT-17, HSP-28a).
#
# Zweite explizite Hörspiel-Instanz (Kind: Neko). Handverdrahtet gemäß
# RAT-17 Entscheidung Option A — KEINE Instanz-Registry, KEIN Port-Offset-
# Algorithmus, KEINE generische Mehr-Instanz-Konvention. HSP-28a verlangt
# zwei explizite Einträge (Paula + Neko) an vier Stellen; dies ist der
# systemd-Eintrag für Neko.
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Port 5055 (PORT-2, `xbuddy-hoerspiel-neko`, HSP-28a).
# Daten-Bereich liegt außerhalb des Checkouts (SVC-5): __XBUDDY_DATA__/hoerspiel/neko.
# Geheimnisse (Anthropic-/Azure-Keys) kommen aus einer ENV-Datei außerhalb
# des Repos (CONFIG-3, HSP-27); die EnvironmentFile-Zeile zeigt den
# Standard-Pfad — der Installer ersetzt __XBUDDY_HOME__.
#
# Pattern-Vermerk: Diese Vorlage liegt wie xbuddy-hoerspiel.service und
# xbuddy-kibuddy.service am Repo-Root statt neben dem Code (hoerspiel/).
# Das weicht von BUD-1a wörtlich ab; die Klärung ist eigenständiger
# /watchdog-Auftrag (HSP-28a-Fußnote), kein Blocker.

[Unit]
Description=XBuddy Hörspiel-Buddy-App (Neko-Instanz)
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
Environment=HOERSPIEL_DATA_ROOT=__XBUDDY_DATA__/hoerspiel/neko
Environment=HOERSPIEL_KIND_ID=neko
EnvironmentFile=-__XBUDDY_HOME__/xbuddy-hoerspiel-neko.env
ExecStart=__XBUDDY_PYTHON__ -m hoerspiel.main --host 127.0.0.1 --port 5055
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
