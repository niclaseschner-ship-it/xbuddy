# XBuddy Photo-Buddy — systemd-Service-Vorlage (SVC-1..4, PHOTO-20).
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Port 5051 (belegt in conventions/ports.md, PORT-2, `xbuddy-photo`).
# Laufzeit braucht ffmpeg/ffprobe (System-Dep, PHOTO-8/9) + Pillow/pillow-heif.

[Unit]
Description=XBuddy Photo-Buddy-App
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
EnvironmentFile=__XBUDDY_DATA__/eltern-chat/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
ExecStart=__XBUDDY_PYTHON__ -m photo.main --host 127.0.0.1 --port 5051
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
