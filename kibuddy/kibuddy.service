# XBuddy KIBuddy-App — systemd-Service-Vorlage (SVC-1..4, KIBUDDY-25).
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Port 5054 (PORT-2, `xbuddy-kibuddy`, KIBUDDY-25).
# Daten-Bereich liegt außerhalb des Checkouts (SVC-5): __XBUDDY_DATA__/kibuddy.
# Geheimnisse (Anthropic-/Azure-Keys) kommen aus einer ENV-Datei außerhalb
# des Repos (CONFIG-3, KIBUDDY-21); die EnvironmentFile-Zeile zeigt den
# Standard-Pfad — der Installer ersetzt __XBUDDY_HOME__.

[Unit]
Description=XBuddy KIBuddy-App
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
Environment=KIBUDDY_DATA_ROOT=__XBUDDY_DATA__/kibuddy
EnvironmentFile=-__XBUDDY_HOME__/xbuddy-kibuddy.env
ExecStart=__XBUDDY_PYTHON__ -m kibuddy.main --host 127.0.0.1 --port 5054
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
