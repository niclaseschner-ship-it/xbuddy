# XBuddy Runner-Health — oneshot Entstau-Check für den self-hosted Runner (#1113).
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/runner/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Läuft NICHT dauerhaft — der Timer (xbuddy-runner-health.timer) triggert diesen
# oneshot-Service periodisch. Er prüft einmal und beendet sich.
#
# Rechte: restartet bei Bedarf `actions.runner...pi5-buddy.service`. Auf einem
# als System-Service installierten Runner braucht das Root — dieser Service
# läuft deshalb OHNE User=-Zeile (als root). Auth für `gh` kommt aus der
# optionalen EnvironmentFile (GH_TOKEN, außerhalb des Repos, SVC-5) — siehe README.

[Unit]
Description=XBuddy Runner-Health — self-hosted Runner gezielt entstauen (#1113)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
# Optionale per-Instanz-EnvironmentFile mit GH_TOKEN (kein Secret im Repo).
# Das führende `-` macht sie optional: fehlt sie, nutzt gh die CLI-Login-Auth.
EnvironmentFile=-__XBUDDY_DATA__/runner/health.env
ExecStart=__XBUDDY_PYTHON__ __XBUDDY_REPO__/deploy/runner/runner_health.py --runner-name __XBUDDY_RUNNER_NAME__ --service __XBUDDY_RUNNER_SERVICE__
