# XBuddy Runner-Health-Timer — triggert den Entstau-Check periodisch (#1113).
#
# Diese Datei ist eine VORLAGE (keine Platzhalter nötig, aber Intervall hier
# dokumentiert). Intervall: alle 5 Minuten. Das ist deckungsgleich mit dem
# Default-Schwellwert N (300s) im Skript — ein stuck-Runner wird spätestens
# ~10 Minuten nach dem Hängenbleiben entstaut, weit vor der bisher
# beobachteten 8–18-Minuten-Handarbeit (#1113).
#
# Aktivieren:  sudo systemctl enable --now xbuddy-runner-health.timer

[Unit]
Description=XBuddy Runner-Health-Timer — Entstau-Check alle 5 Minuten (#1113)

[Timer]
# 2 Minuten nach Boot das erste Mal, danach alle 5 Minuten.
OnBootSec=2min
OnUnitActiveSec=5min
# Verpasste Läufe (z. B. nach Suspend) sofort nachholen.
Persistent=true
Unit=xbuddy-runner-health.service

[Install]
WantedBy=timers.target
