# deploy/host-profile.example.env — Beispiel-Host-Profil für deploy/bootstrap.sh
#
# Kopieren nach deploy/host-profile.env (oder beliebiger Pfad), Werte anpassen,
# dann aufrufen:
#
#   bash deploy/bootstrap.sh --profile deploy/host-profile.env
#   bash deploy/bootstrap.sh --profile deploy/host-profile.env --dry-run
#
# Alle 8 __XBUDDY_*__-Platzhalter müssen belegt sein — bootstrap.sh prüft das.
# Diese Datei NIEMALS mit echten Werten in das Repo committen.

# Linux-User, unter dem die Services laufen.
XBUDDY_USER=buddy

# Home-Verzeichnis dieses Users.
XBUDDY_HOME=/home/buddy

# Pfad zum gecheckten xbuddy-Repo auf der Instanz.
XBUDDY_REPO=/home/buddy/repos/xbuddy

# Python-Interpreter mit installierten Repo-Abhängigkeiten (im Venv).
# bootstrap.sh erzeugt dieses Venv falls --setup-venv übergeben wird.
XBUDDY_PYTHON=/home/buddy/apps/venv/bin/python

# Wurzel der Per-Instanz-Daten außerhalb des Checkouts (SVC-5).
XBUDDY_DATA=/home/buddy/xbuddy-data

# Display-Origin für Heimnetz-Zugriff (SREG-7).
XBUDDY_DISPLAY_ORIGIN_HEIM=https://xbuddy-hub.local:8443

# Display-Origin für Tailscale-Zugriff (SREG-7, 4-Segment-Form).
XBUDDY_DISPLAY_ORIGIN_TAILSCALE=https://xbuddy-hub.tailnet-xxxx.ts.net:8443

# Funnel-FQDN mit LE-Cert für externe Familien-Geräte (SREG-7, AUTH-7b).
# Leer lassen = kein externer Familien-Geräte-Zugang (SEITEN_FUNNEL_ORIGIN).
XBUDDY_DISPLAY_ORIGIN_FUNNEL=https://buddyboard.<tailscale-id>.ts.net
