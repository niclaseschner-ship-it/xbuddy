[Unit]
Description=XBuddy: LE-Cert (Tailscale) für nginx erneuern + reload
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --min-validity 720h: holt nur neu, wenn <30 Tage Restlaufzeit; sonst Cache (kein LE-Call).
ExecStart=/usr/bin/tailscale cert --min-validity 720h --cert-file /var/lib/tailscale/certs/__XBUDDY_TAILSCALE_FQDN__.crt --key-file /var/lib/tailscale/certs/__XBUDDY_TAILSCALE_FQDN__.key __XBUDDY_TAILSCALE_FQDN__
# reload nur nach erfolgreichem cert-Schritt (ExecStartPost läuft nicht bei ExecStart-Fehler)
ExecStartPost=/usr/sbin/nginx -t
ExecStartPost=/bin/systemctl reload nginx
