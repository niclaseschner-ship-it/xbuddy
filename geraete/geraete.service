# XBuddy Geräte-Registry HTTP-Service (GER-13/GER-14/GER-15) — systemd-Service-Vorlage.
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Bindet auf Loopback-Port 5040 (PORT-2). Öffentlich erreichbar nur über
# nginx-Origin auf :8443 (URL-12/URL-14).

[Unit]
Description=XBuddy Geräte-Registry HTTP-Service (GER-13/GER-14/GER-15)
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
ExecStart=__XBUDDY_PYTHON__ -m geraete.main --host 127.0.0.1 --port 5040 --geraete __XBUDDY_REPO__/geraete/geraete.json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
