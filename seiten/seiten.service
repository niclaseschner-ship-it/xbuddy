# XBuddy Seiten-Registry HTTP-Service (SREG-3) — systemd-Service-Vorlage.
#
# Diese Datei ist eine VORLAGE. Vor `systemctl enable` Platzhalter ersetzen
# (siehe deploy/systemd/README.md). Per-Instanz-Werte stehen nie im Repo.
#
# Bindet auf Loopback-Port 5042 (PORT-2). Öffentlich erreichbar nur über
# nginx-Origin auf :8443 (URL-12/URL-14, location = /api/v1/seiten). Aggregiert
# das Inventar aller aufrufbaren Views (SREG-1) aus den committeten
# views.json-Manifesten im Repo (--root) + Snapshots der Panel-/Geräte-Registry,
# und cacht es in inventar.json (SREG-3, --inventar).
#
# SVC-5: der inventar.json-Cache liegt AUSSERHALB des Checkouts unter
# __XBUDDY_DATA__/seiten/ — der Checkout ist Dev-Root + Service-CWD
# zugleich, abgeleitete Laufzeit-Daten dürfen nicht an den Branch-Stand koppeln.
# --root zeigt dagegen bewusst IN den Checkout: die committeten Manifeste SIND
# Repo-Inhalt (SREG-2, committet neben dem Code).

[Unit]
Description=XBuddy Seiten-Registry HTTP-Service (SREG-3)
After=network-online.target
Wants=network-online.target

[Service]
User=__XBUDDY_USER__
WorkingDirectory=__XBUDDY_REPO__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=__XBUDDY_HOME__
# SREG-7: Display-URL-Origins für die SREG-12-Übersichts-Seite.
# Heim-Origin ist Pflicht (sonst keine kopierbaren Heim-URLs); Tailscale-Origin
# ist V1-Soll (leer = SREG-12 zeigt Banner statt zweiter URL-Spalte).
# Beide Werte sind PER-INSTANZ — Platzhalter werden beim systemctl enable
# durch die echten Origins ersetzt (deploy/systemd/README.md).
Environment=SEITEN_HEIM_ORIGIN=__XBUDDY_DISPLAY_ORIGIN_HEIM__
Environment=SEITEN_TAILSCALE_ORIGIN=__XBUDDY_DISPLAY_ORIGIN_TAILSCALE__
ExecStart=__XBUDDY_PYTHON__ -m seiten.main --host 127.0.0.1 --port 5042 --root __XBUDDY_REPO__ --inventar __XBUDDY_DATA__/seiten/inventar.json --panel-url http://127.0.0.1:5041 --geraete-url http://127.0.0.1:5040
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
